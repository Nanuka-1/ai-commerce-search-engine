# Образец настроек. Скопируйте в .env и заполните. Настоящий .env в git НЕ попадает (.gitignore).
# Секреты (пароль базы, ключи) хранятся в менеджере паролей и в переменных окружения хостинга — не в репозитории.

# --- База данных (Neon PostgreSQL) — СЕКРЕТ ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Кэш ---
# memory — в памяти процесса (локально, тесты); redis — общий кэш (сервер)
CACHE_BACKEND=memory
# нужен только при CACHE_BACKEND=redis — СЕКРЕТ, если в адресе есть пароль
REDIS_URL=

# --- Gemini (понимание сообщения, текст ответа, эмбеддинги) — СЕКРЕТ ---
GEMINI_API_KEY=

# --- ИИ ---
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=
# модели через запятую, первая — основная (пример: gemini-3.5-flash-lite)
LLM_MODELS=

# необязательно: лимит понимания сообщения, с (по умолчанию 3)
# LLM_UNDERSTANDING_BUDGET_SECONDS=3
# необязательно: во сколько раз дольше ждать ИИ, когда правила не поняли ничего (по умолчанию 2.5)
# LLM_UNDERSTANDING_PATIENT_FACTOR=2.5

# --- Смысловой поиск (pgvector + эмбеддинги Gemini) ---
SEMANTIC_SEARCH_ENABLED=true
